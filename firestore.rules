rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A user is a manager only if a doc exists at admins/{uid}.
    // Add that doc by hand in the Firebase console; nobody can create it from the app.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /posts/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 100000
        && request.resource.data.published is bool;
      allow delete: if isAdmin();
    }

    match /media/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.type in ['image', 'video']
        && request.resource.data.url is string;
      allow delete: if isAdmin();
    }

    // ---- Etqan (halaqa management). Admin-only for now; teachers get their own rules later. ----
    // Records are never deleted (archive instead), and every update bumps `version` by exactly one
    // so two people editing the same record can't silently overwrite each other.
    match /{collection}/{id} {
      allow read: if isAdmin()
        && collection.matches('etqan_(organizations|centers|mosques|circles|periods|programs|curricula|courses|users|settings|audit|meta)');
      allow create: if isAdmin()
        && collection.matches('etqan_(organizations|centers|mosques|circles|periods|programs|curricula|courses|users)')
        && request.resource.data.version == 1
        && request.resource.data.archivedAt == null;
      allow update: if isAdmin()
        && collection.matches('etqan_(organizations|centers|mosques|circles|periods|programs|curricula|courses|users)')
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    // Settings are insert-only: each change is a new version doc `${key}@${version}`.
    match /etqan_settings/{id} {
      allow create: if isAdmin()
        && id == request.resource.data.key + '@' + string(request.resource.data.version);
      allow update, delete: if false;
    }

    // Audit log is append-only; the head doc tracks the last link of the hash chain.
    match /etqan_audit/{id} {
      allow create: if isAdmin() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }
    match /etqan_meta/audit_head {
      allow create: if isAdmin() && request.resource.data.chainNo == 1;
      allow update: if isAdmin() && request.resource.data.chainNo == resource.data.chainNo + 1;
      allow delete: if false;
    }
  }
}
